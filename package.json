{
  "name": "ScholarshipSuite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",

    "dev:services": "turbo run dev --filter=services/*",
    "dev:web": "turbo run dev --filter=apps/web",
    "dev:all": "turbo run dev",

    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "gateway"
  ]
}
